         │                        │                          │                                                   │               resolucion: FAVOR_SOLICITANTE,                              │                                                                    │                  │       
         │                        │                          │                                                   │               accion_pago: REEMBOLSO_TOTAL,                               │                                                                    │                  │       
         │                        │                          │                                                   │               justificacion: "Evidencias insuficientes PDS"               │                                                                    │                  │       
         │                        │                          │                                                   │             }                                                             │                                                                    │                  │       
         │                        │                          │                                                   │──────────────────────────────────────────────────────────────────────────>│                                                                    │                  │       
         │                        │                          │                                                   │                                                                           │                                                                    │                  │       
         │                        │                          │                                                   │                                                                           │           UPDATE disputes SET estado='RESUELTA',                   │                  │       
         │                        │                          │                                                   │                                                                           │             resolucion=..., resuelto_por=superadmin_id             │                  │       
