@startuml
' ============================================================
' Diagrama ER Simplificado por Modulos - ChambeApp
' Formato UML relacional con alas (Crow's Foot): ||, o|, |{, o{
' ============================================================

skinparam monochrome true
skinparam shadowing false
skinparam handwritten false
hide stereotype
hide circle
hide methods
hide empty members

title Diagrama ER Simplificado - ChambeApp por Modulos

' ==================== MODULO 1: IDENTIDAD ====================
entity "users" as U {
  * id: int [PK]
  --
  email: varchar(255) [UK, NN]
  password_hash: varchar(255) [NN]
  rol: enum [NN]
  status: varchar(20)
  role_version: int
  nombre: varchar(120)
  username: varchar(60) [UK]
  telefono: varchar(30)
  edad_verificada: bool
  acepto_tyc: bool
  consentimiento_datos: bool
  email_verificado: bool
  fecha_registro: datetime
  last_login: datetime
  activo: bool
  two_factor_enabled: bool
  region_id: int [FK -> regions.id]
}

entity "profiles" as P {
  * user_id: int [PK, FK -> users.id]
  --
  habilidades: json
  experiencia: text
  zona: varchar(120)
  calificacion_promedio: float
  verificado: bool
  badges: json
  portafolio: json
  categorias: json
  perfil_completo: bool
  foto_perfil: varchar(500)
  latitud: float
  longitud: float
  geom: Geometry(POINT,4326)
  plan: varchar(20)
  destacado: bool
  onboarding_completed: bool
  onboarding_step: int
}

entity "roles" as R {
  * id: int [PK]
  --
  nombre: enum [NN]
  permisos_json: json
}

entity "regions" as REG {
  * id: int [PK]
  --
  clave: varchar(40) [UK]
  nombre: varchar(120) [NN]
  descripcion: text
  departamentos: json
  created_at: datetime
}

entity "user_sessions" as S {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  refresh_token_hash: varchar
  device_info: varchar
  ip: varchar
  expira_en: datetime
  revocado: bool
}

entity "legal_acceptances" as LA {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  version_tyc: varchar(20)
  fecha: datetime
  ip: varchar(45)
}

' Verificaciones unificadas: KYC, email, telefono, identidad
entity "verifications" as V {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  tipo: enum [KYC/EMAIL/PHONE/IDENTITY] [NN]
  status: varchar(20) [NN]
  document_type: varchar(50)
  document_number: varchar(100)
  codigo_hash: varchar
  expira_en: datetime
  reviewed_by: int [FK -> users.id]
  reviewed_at: datetime
  reason: text
  created_at: datetime
  updated_at: datetime
}

' ==================== MODULO 2: KYC DOCUMENTOS ====================
entity "kyc_required_documents" as KYC_R {
  * clave: varchar [PK]
  --
  grupo: varchar
  obligatorio: bool
  multi_instancia: bool
  orden: int
  rol_aplicable: varchar
}

entity "user_kyc_documents" as KYC_U {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  documento_clave: varchar [FK -> kyc_required_documents.clave]
  instancia: int
  estado: varchar
  minio_url: varchar
  hash_sha256: varchar
  revisado_por: int [FK -> users.id]
  revisado_en: datetime
  observacion: text
  created_at: datetime
}

' ==================== MODULO 3: SERVICIOS (SOLICITUDES/OFERTAS/CONTRATOS) ====================
entity "solicitudes" as SOL {
  * id: int [PK]
  --
  solicitante_id: int [FK -> users.id]
  categoria: varchar(120)
  titulo: varchar(200)
  descripcion: text
  ubicacion: varchar(120)
  latitud: float
  longitud: float
  direccion: varchar(255)
  presupuesto: int
  fecha_deseada: date
  urgencia: enum
  estado: enum
  especificaciones_tecnicas: json
  imagen_360: text
  horario: varchar(80)
  imagenes: json
  radio_km: float
  creado_en: datetime
  actualizado_en: datetime
}

entity "ofertas" as OF {
  * id: int [PK]
  --
  solicitud_id: int [FK -> solicitudes.id]
  pds_id: int [FK -> users.id]
  monto: float
  mensaje: text
  fecha_deseada: date
  horario: varchar(80)
  estado: enum
  contra_monto: float
  contra_mensaje: text
  contra_fecha_deseada: date
  contra_horario: varchar(80)
  created_at: datetime
  updated_at: datetime
}

entity "contracts" as CON {
  * id: int [PK]
  --
  solicitud_id: int [FK -> solicitudes.id]
  proveedor_id: int [FK -> users.id]
  solicitante_id: int [FK -> users.id]
  estado: enum
  motivo_cancelacion: varchar(500)
  monto_total: int
  inicio_en: datetime
  fin_en: datetime
  confirmado_en: datetime
  creado_en: datetime
  actualizado_en: datetime
}

' Expedicion de ejecucion 1:1 con contrato
entity "contract_execution" as CE {
  * contract_id: int [PK, FK -> contracts.id]
  --
  estado: enum [NN]
  estado_previo: enum
  fecha_activacion: datetime
  fecha_inicio_obra: datetime
  fecha_solicitud_cierre: datetime
  fecha_validacion: datetime
  fecha_liquidacion: datetime
  fecha_finalizacion: datetime
  evidencia_entrada: json
  evidencia_salida: json
  novedades: json
  pago_confirmado_solicitante: bool
  pago_confirmado_prestador: bool
  pago_directo_confirmado: bool
  pago_monto_final: int
  rating_estrellas: int
  rating_comentario: text
  habilidades_validadas: json
  creado_en: datetime
  actualizado_en: datetime
}

entity "adendas" as AD {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id]
  tipo: enum [ALCANCE/PRECIO/NOVEDAD/DERIVACION]
  descripcion: text
  monto_ajuste: numeric
  estado: varchar
  creado_por: int [FK -> users.id]
  created_at: datetime
}

entity "evidencias" as EV {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id]
  tipo: enum [ENTRADA/SALIDA/ADENDA/NOVEDAD]
  minio_urls: json
  hash_sha256: json
  metadatos_exif_json: json
  subido_por: int [FK -> users.id]
  created_at: datetime
}

entity "hitos" as HI {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id]
  numero: int [1-6]
  nombre: varchar
  estado: varchar
  aprobado_por: int [FK -> users.id]
  aprobado_en: datetime
  observacion: text
  created_at: datetime
}

entity "ratings_solicitud" as RS {
  * id: int [PK]
  --
  solicitud_id: int [FK -> solicitudes.id]
  autor_id: int [FK -> users.id]
  calificado_id: int [FK -> users.id]
  puntaje: int [1-5]
  comentario: text
  reportado: bool
  creado_en: datetime
}

' ==================== MODULO 4: MARANAS (SUBCONTRATACION) ====================
entity "maranas" as MA {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id]
  pds_id: int [FK -> users.id]
  descripcion: text
  presupuesto: numeric
  estado: varchar
  created_at: datetime
}

entity "ofertas_marana" as OM {
  * id: int [PK]
  --
  marana_id: int [FK -> maranas.id]
  pds_id: int [FK -> users.id]
  precio: numeric
  mensaje: text
  estado: varchar
  created_at: datetime
}

' ==================== MODULO 5: FINANZAS ====================
entity "wallets" as W {
  * user_id: int [PK, FK -> users.id]
  --
  saldo: int
  saldo_bloqueado: int
  updated_at: datetime
}

entity "transactions" as T {
  * id: int [PK]
  --
  wallet_id: int [FK -> wallets.user_id]
  tipo: enum
  monto: int
  descripcion: text
  referencia: varchar(100)
  created_at: datetime
}

entity "payments" as PAY {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id, UK]
  monto: int
  comision_pds: int
  comision_solicitante: int
  estado: enum
  pasarela: varchar(50)
  referencia_pasarela: varchar(255)
  motivo_reembolso: varchar(500)
  creado_en: datetime
  actualizado_en: datetime
}

' Checkin geografico pertenece a la ejecucion del contrato, no al pago
entity "contract_checkins" as CC {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id]
  tipo: enum [ENTRADA/SALIDA]
  latitud: float
  longitud: float
  distancia_m: float
  evidencias_urls: json
  creado_en: datetime
}

entity "coins" as CO {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  tipo: enum [COMPRADA/PROMOCIONAL/GANADA]
  cantidad: int
  vence_en: datetime
  created_at: datetime
}

entity "coin_packages" as CP {
  * id: int [PK]
  --
  nombre: varchar
  monedas: int
  precio_cop: int
  modalidad: enum [A/B]
  activo: bool
}

entity "precios_sugeridos" as PS {
  * id: int [PK]
  --
  categoria: varchar
  precio_min: int
  precio_max: int
  precio_promedio: int
  muestra_n: int
  actualizado_en: datetime
}

' ==================== MODULO 6: NEGOCIOS / MERCHANT ====================
entity "negocios" as NEG {
  * id: int [PK]
  --
  owner_id: int [FK -> users.id]
  nombre: varchar(150)
  slug: varchar(170) [UK]
  descripcion: text
  tipo: enum
  logo_url: varchar(500)
  banner_url: varchar(500)
  imagenes: json
  latitud: float
  longitud: float
  direccion: varchar(255)
  ciudad: varchar(100)
  departamento: varchar(100)
  radio_cobertura_km: float
  geom: Geometry(POINT,4326)
  categoria_principal: varchar(120)
  categorias_secundarias: json
  servicios: json
  palabras_clave: json
  whatsapp: varchar(30)
  whatsapp_mensaje_pre: text
  instagram: varchar(255)
  facebook: varchar(255)
  tiktok: varchar(255)
  sitio_web: varchar(255)
  calificacion_promedio: float
  total_calificaciones: int
  verificado: bool
  estado: enum
  motivo_rechazo: text
  comision_pct: float
  cuenta_bancaria_encriptada: varchar
  creado_en: datetime
  actualizado_en: datetime
}

entity "negocio_horarios" as NH {
  * id: int [PK]
  --
  negocio_id: int [FK -> negocios.id]
  dia_semana: int [0-6]
  abierto: bool
  hora_apertura: time
  hora_cierre: time
}

entity "negocio_ratings" as NR {
  * id: int [PK]
  --
  negocio_id: int [FK -> negocios.id]
  autor_id: int [FK -> users.id]
  puntaje: int [1-5]
  comentario: text
  reportado: bool
  creado_en: datetime
}

entity "negocio_reportes" as NREP {
  * id: int [PK]
  --
  negocio_id: int [FK -> negocios.id]
  reporter_id: int [FK -> users.id]
  tipo: enum
  descripcion: text
  estado: enum
  ticket_id: int [FK -> tickets.id]
  creado_en: datetime
}

entity "anuncios_laborales" as AN {
  * id: int [PK]
  --
  negocio_id: int [FK -> negocios.id]
  titulo: varchar
  descripcion: text
  requisitos: text
  salario_ofrecido: int
  tipo_contrato: varchar
  ubicacion: varchar
  estado: varchar
  created_at: datetime
}

entity "postulaciones_anuncio" as PA {
  * id: int [PK]
  --
  anuncio_id: int [FK -> anuncios_laborales.id]
  user_id: int [FK -> users.id]
  cv_url: varchar
  mensaje: text
  estado: varchar
  created_at: datetime
}

' ==================== MODULO 7: COMUNICACION ====================
entity "conversations" as CV {
  * id: int [PK]
  --
  user_a_id: int [FK -> users.id]
  user_b_id: int [FK -> users.id]
  creado_en: datetime
}

entity "messages" as MSG {
  * id: int [PK]
  --
  conversation_id: int [FK -> conversations.id]
  sender_id: int [FK -> users.id]
  contenido: text
  leido: bool
  creado_en: datetime
}

entity "notifications" as NOTIF {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  tipo: varchar
  titulo: varchar(200)
  mensaje: text
  datos: json
  leida: bool
  creado_en: datetime
}

entity "notification_preferences" as NP {
  * user_id: int [PK, FK -> users.id]
  --
  push_habilitado: bool
  in_app_habilitado: bool
  email_habilitado: bool
  categorias_json: json
}

entity "presence" as PR {
  * user_id: int [PK, FK -> users.id]
  --
  online: bool
  last_seen: datetime
  socket_id: varchar
  heartbeat_at: datetime
}

' ==================== MODULO 8: GOBERNANZA / AUDITORIA ====================
entity "audit_logs" as AL {
  * id: int [PK]
  --
  actor_id: int [FK -> users.id]
  accion: varchar
  entidad_tipo: varchar
  entidad_id: int
  snapshot_diff_json: json
  ip_address: varchar
  user_agent: varchar
  timestamp_utc: datetime
}

entity "disputes" as D {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id]
  iniciado_por: int [FK -> users.id]
  tipo: enum
  estado: enum
  resolucion: text
  resuelto_por: int [FK -> users.id]
  resuelto_en: datetime
  created_at: datetime
}

entity "tickets" as TK {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  tipo: enum
  prioridad: enum
  estado: enum
  asignado_a: int [FK -> users.id]
  respuesta: text
  creado_en: datetime
  cerrado_en: datetime
}

entity "moderacion_contenido" as MC {
  * id: int [PK]
  --
  entidad_tipo: varchar
  entidad_id: int
  reportado_por: int [FK -> users.id]
  motivo: text
  estado: enum
  accion_tomada: varchar
  moderador_id: int [FK -> users.id]
  created_at: datetime
}

entity "region_scoping" as RS2 {
  * admin_id: int [FK -> users.id]
  * region_id: int [FK -> regions.id]
  --
  permiso: enum [LECTURA/ESCRITURA/ADMIN]
}

' ==================== MODULO 9: IA / RECOMENDACION ====================
entity "pds_embeddings" as PE {
  * pds_id: int [PK, FK -> users.id]
  --
  embedding: vector(384)
  modelo_version: varchar
  actualizado_en: datetime
}

entity "solicitud_embeddings" as SE {
  * solicitud_id: int [PK, FK -> solicitudes.id]
  --
  embedding: vector(384)
  modelo_version: varchar
}

entity "recommendation_logs" as RL {
  * id: int [PK]
  --
  solicitud_id: int [FK -> solicitudes.id]
  pds_id: int [FK -> users.id]
  score_retrieval: float
  score_ranking: float
  shap_explanation_json: json
  clicked: bool
  contratado: bool
  created_at: datetime
}

entity "feature_flags" as FF {
  * nombre: varchar [PK]
  --
  habilitado: bool
  descripcion: text
  modelo_version: varchar
  actualizado_por: int [FK -> users.id]
}

' ==================== MODULO 10: SISTEMA / UTILIDADES ====================
entity "system_config" as SC {
  * clave: varchar [PK]
  --
  valor_json: json
  descripcion: text
  editable: bool
}

entity "migrations_log" as ML {
  * version: varchar [PK]
  --
  descripcion: text
  aplicado_en: datetime
  exito: bool
  checksum: varchar
}

entity "seed_data" as SD {
  * tabla: varchar [PK]
  --
  registro_json: json
  version: varchar
  aplicado: bool
}

entity "api_rate_limits" as ARL {
  * endpoint: varchar [PK]
  * metodo: varchar [PK]
  --
  limite_ventana: int
  ventana_segundos: int
  rol_excluido: varchar
}

' ============================================================
' RELACIONES UML POR MODULO
' ============================================================

' --- Modulo 1: Identidad ---
U ||--o| P : "tiene un perfil"
P ||--|| U : "pertenece a"

R ||--|{ U : "asigna rol a"

REG ||--|{ U : "agrupa usuarios en"

U ||--|{ S : "mantiene sesiones"

U ||--|{ LA : "acepta terminos"

U ||--|{ V : "tiene verificaciones"
U }|--o{ V : "revisa verificaciones (verificador)"

' --- Modulo 2: KYC ---
U ||--|{ KYC_U : "sube documentos KYC"
KYC_R ||--|{ KYC_U : "define tipos de documento"

' --- Modulo 3: Servicios ---
U ||--|{ SOL : "publica solicitudes (solicitante)"

SOL ||--|{ OF : "recibe ofertas"
U ||--|{ OF : "PDS hace ofertas"

SOL ||--|{ CON : "da origen a contratos"
U ||--|{ CON : "proveedor firma"
U ||--|{ CON : "solicitante contrata"

CON ||--|| CE : "expediente de ejecucion (1:1)"
CON ||--|{ AD : "tiene adendas"
CON ||--|{ EV : "soporta evidencias"
CON ||--|{ HI : "tiene hitos de cierre"
CON ||--|{ CC : "tiene checkins geograficos"

SOL ||--|{ RS : "calificada"
U ||--|{ RS : "autor califica"
U ||--|{ RS : "calificado"

' --- Modulo 4: Maranas ---
CON ||--|{ MA : "deriva a marañas"
U ||--|{ MA : "PDS gestiona marana"

MA ||--|{ OM : "recibe ofertas de marana"
U ||--|{ OM : "PDS ofertar en marana"

' --- Modulo 5: Finanzas ---
U ||--|| W : "tiene billetera (1:1)"
W ||--|{ T : "registra movimientos"
U ||--|{ CO : "posee monedas"

CON ||--|| PAY : "tiene un pago (1:1)"
CON ||--|{ CC : "registra checkins de ejecucion"

' --- Modulo 6: Negocios ---
U ||--|{ NEG : "es dueno de negocios"
NEG ||--|{ NH : "tiene horarios"
NEG ||--|{ NR : "calificado por usuarios"
U ||--|{ NR : "califica negocios"
NEG ||--|{ NREP : "es reportado"
U ||--|{ NREP : "reporta negocios"
TK ||--o{ NREP : "vinculado a ticket (opcional)"
NEG ||--|{ AN : "publica anuncios laborales"
AN ||--|{ PA : "recibe postulaciones"
U ||--|{ PA : "postula a anuncios"

' --- Modulo 7: Comunicacion ---
U ||--|{ CV : "participante A"
U ||--|{ CV : "participante B"
CV ||--|{ MSG : "contiene mensajes"
U ||--|{ MSG : "envia mensajes"
U ||--|{ NOTIF : "recibe notificaciones"
U ||--|| NP : "configura notificaciones (1:1)"
U ||--|| PR : "presencia en tiempo real (1:1)"

' --- Modulo 8: Gobernanza ---
U ||--|{ AL : "actor de auditoria"
CON ||--|{ D : "genera disputas"
U ||--|{ D : "inicia disputa"
U }|--o{ D : "resuelve disputa (opcional)"
U ||--|{ TK : "abre tickets"
U }|--o{ TK : "asignado a tickets (opcional)"
U ||--|{ MC : "reportado por"
U ||--|{ MC : "moderado por"
U ||--|{ RS2 : "admin con alcance regional"
REG ||--|{ RS2 : "alcance regional de"

' --- Modulo 9: IA ---
U ||--|| PE : "embedding PDS (1:1)"
SOL ||--|| SE : "embedding solicitud (1:1)"
SOL ||--|{ RL : "recomendada en logs"
U ||--|{ RL : "PDS recomendado en logs"
U }|--o{ FF : "actualiza feature flags (opcional)"

' ==================== NOTA: HERENCIA ====================
note top of U
  HERENCIA: No existe herencia de tablas
  (joined / single-table / concrete) en
  SQLAlchemy. Todas las relaciones son
  asociacion / composicion mediante claves
  foraneas. No hay entidades padre/hija
  con supertipo/subtipo.
end note

@enduml
