           │                    │                      │                        │                                             │                                  │                                                   │                                                             │                                    │                                    │                                       │                                     │                               │                           │ ║• POST /documents/:id/approve → estado=aprobado, revisado_por=verificador  ║             │                         
           │                    │                      │                        │                                             │                                  │                                                   │                                                             │                                    │                                    │                                       │                                     │                               │                           │ ║• POST /documents/:id/reject  → estado=rechazado, nota                     ║             │                         
