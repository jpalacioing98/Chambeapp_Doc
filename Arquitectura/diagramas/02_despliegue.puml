@startuml
title ChambeApp - Diagrama de Despliegue (Produccion)
skinparam componentStyle rectangle

actor "Usuario (PWA)" as U

node "Nginx (HTTPS/WSS)" as NGX
node "Gunicorn + Flask API" as API {
  [Flask App] as FL
  [Socket.IO Server] as SIO
}
node "Celery Worker + Beat" as CEL
node "Redis" as RD
node "PostgreSQL + PostGIS" as DB
node "MinIO" as MIN
node "Static Host (PWA build)" as STAT

U --> NGX : HTTPS/WSS
NGX --> STAT : assets
NGX --> FL : proxy
NGX --> SIO : proxy ws
FL --> DB
FL --> RD : cache + MQ
SIO --> RD : message_queue
FL --> CEL : tareas
CEL --> RD
CEL --> MIN
FL --> MIN : storage
@enduml
