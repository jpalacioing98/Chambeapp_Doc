@startuml
title ChambeApp - Moderación, Soporte y Gobernanza Superadmin (Flujo 14)
skinparam componentStyle rectangle
skinparam sequenceMessageAlign center

actor "Solicitante" as SOL
actor "PDS (Trabajador)" as PDS
actor "Admin Regional\n(Región 1)" as ADM
actor "Superadmin\n(Universal)" as SUP

package "Frontend React (Vite)" {
  [Centro de Disputas\n(DisputasPage.tsx)] as FE_DISP
  [Consola de Moderación\n(Admin/Superadmin Panel)] as FE_ADM
}

package "API Gateway (Flask-Smorest)" {
  [/api/v1/contracts/:id/disputes] as API_DISP
  [/api/v1/tickets/] as API_TICK
  [/api/v1/admin/stats] as API_STATS
  [/api/v1/admin/disputes/:id/resolve] as API_RES
  [/api/v1/superadmin/flags] as API_FLAGS
  [/api/v1/superadmin/audit-logs] as API_AUDIT
}

package "Control Regional & Seguridad" {
  [region_scope_id\n(Enforcer Regional)] as SCOPE
}

database "PostgreSQL 16" {
  [disputes] as DB_DISP
  [tickets] as DB_TICK
  [feature_flags] as DB_FLAGS
  [audit_logs\n(RNF-AUD Inmutable)] as DB_AUDIT
}

SOL --> FE_DISP : Radica disputa (Contrato #1)
FE_DISP --> API_DISP : POST /contracts/1/disputes
API_DISP --> DB_DISP : INSERT dispute (abierta)

PDS --> API_TICK : POST /tickets/ (asistencia formalización)
API_TICK --> DB_TICK : INSERT ticket (open)

ADM --> FE_ADM : Gestiona tickets y KPIs
FE_ADM --> API_STATS : GET /admin/stats (JWT Admin R1)
API_STATS --> SCOPE : region_scope_id = 1
SCOPE --> DB_DISP : Filtra por Región 1

ADM --> API_DISP : GET /admin/disputes/2 (Región 2)
API_DISP --> SCOPE : Compara R1 vs R2
SCOPE --> ADM : HTTP 404 (Aislamiento Regional)

SUP --> FE_ADM : Arbitraje y Flags
FE_ADM --> API_RES : POST /admin/disputes/2/resolve
API_RES --> DB_DISP : UPDATE dispute (resuelta / laudo)
API_RES --> DB_AUDIT : Pista de auditoría forense

FE_ADM --> API_FLAGS : PATCH /flags/ml_ranking_enabled
API_FLAGS --> DB_FLAGS : UPDATE flag en caliente
API_FLAGS --> DB_AUDIT : INSERT audit_log (diff)

FE_ADM --> API_AUDIT : GET /superadmin/audit-logs
API_AUDIT --> DB_AUDIT : SELECT pistas inmutables
@enduml
