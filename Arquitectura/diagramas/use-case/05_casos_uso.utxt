                                                                                                                                                                                                                                                                                                                                                                    ┌───────────────────────────────────────────────────────┐                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                                                                                                                                    │SOLICITANTE (rol público):                             │                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ┌───────────────────────────────────────────────────────────┐                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         ┌─────────────────────────────────────────────────────┐                                              
                                                                                                                                                                                                                                                                                                                                                                    ├───────────────────────────────────────────────────────┤                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                │PDS (rol trabajador):                                      │                                                                                                                                                                                                                                                                                                                                             ┌───────────────────────────────────────────────────────────────────┐                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       │SUPERADMIN (global):                                 │                                              
                                                                                                                                                                                                                                                                                                                                                                    │• Recibe ranking ML explicable (SHAP)                  │                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                ├───────────────────────────────────────────────────────────┤                                                                                                                                                                                                                                                                                                                                             │ADMIN REGIONAL (scoped):                                           │                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       ├─────────────────────────────────────────────────────┤                                              
                                                                                                                                                                                                                                                                                                                                                                    │• Negocia ofertas (contraofertas precio/fecha/horario) │                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                │• Envía ofertas con negociación completa                   │                                                                                                                                                                                                                                                                                                                                             ├───────────────────────────────────────────────────────────────────┤                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       │• Audit logs inmutables (hash chain, 10 años)        │                                              
                                                                                                                                                                                                                                                                                                                                                    ┌───────────┐   │• Firma contrato digital SHA256                        │                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ┌───┐   │• Trust Score + Badges visibles para solicitante           │                                                                                                                                                                                                                                                                                                                           ┌──────────────┐  │• Users, solicitudes, contratos, disputas, tickets → SOLO su región│                                                                            ┌────────┐                                                                                                                                                                                   ┌───────────┐                                                                                                ┌───────┐                                                                                                                                     