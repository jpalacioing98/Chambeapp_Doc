                                                                                                                                                                                                                                                                                                                                                    ├───────────┤---│• Pago dual conformidad + calificación bilateral       │                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        ├───┤---│• Pago dual → saldo wallet inmediato                       │                                                                                                                                                                                                                                                                                                                           ├──────────────┤--│• Resolución disputas + laudo (dentro scope)                       │                                                                            ├────────┤                                                                                                                                                                                   ├───────────┤                                                                                                ├───────┤                                                                                                                                     