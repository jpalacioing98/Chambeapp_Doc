@startuml
title ChambeApp - Modelo de Datos (Entidades Clave)
skinparam classAttributeIconSize 0

class User {
  id
  rol
  email
  password_hash
  verificado
}
class Profile {
  user_id
  habilidades
  calificacion_promedio
}
class Solicitud {
  id
  categoria
  presupuesto
  radio_km
  estado
}
class Order {
  id
  service_id
  proveedor_id
  estado
}
class Trust {
  user_id
  trust_score
  dimensiones (KYC, rating, contratos, portfolio, referidos)
}
class Badge {
  id
  user_id
  tipo
}
class NotificationCascade {
  id
  solicitud_id
  fase
  radio_km
}
class RecommendationLog {
  id
  user_id
  grupo_ab
  score
}
class PortfolioItem {
  id
  user_id
  url_minio
  tipo
}
class Wallet {
  id
  user_id
  saldo
}

User "1" --> "1" Profile
User "1" --> "*" Solicitud
User "1" --> "1" Trust
User "1" --> "*" Badge
User "1" --> "1" Wallet
User "1" --> "*" PortfolioItem
Solicitud "1" --> "*" NotificationCascade
Solicitud "1" --> "*" Order
User "1" --> "*" RecommendationLog
@enduml
