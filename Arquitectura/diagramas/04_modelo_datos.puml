@startuml
title ChambeApp - Modelo de Datos (v2.0 - Con Billetera Virtual)

entity User {
  * id
  * rol
  * email
  * password_hash
  edad_verificada
  acepto_tyc
  fecha_registro
}

entity Profile {
  * user_id
  habilidades
  experiencia
  zona
  calificacion_promedio
  verificado
  badges
}

entity Service {
  * id
  * solicitante_id
  categoria
  descripcion
  ubicacion
  presupuesto
  estado
}

entity Order {
  * id
  * service_id
  * proveedor_id
  estado
  creado_en
}

entity Payment {
  * id
  * order_id
  monto
  comision
  estado
  pasarela
  liberado_en
}

entity Subscription {
  * id
  * user_id
  plan
  estado
  renueva_en
}

entity Rating {
  * id
  * order_id
  autor_id
  calificado_id
  puntaje
  comentario
}

entity Dispute {
  * id
  * order_id
  motivo
  estado
  resuelto_en
}

entity LegalAcceptance {
  * id
  * user_id
  version_tyc
  fecha
  ip
}

entity Wallet {
  * id
  * user_id
  saldo
  saldo_bloqueado
  created_at
  updated_at
}

entity Coin {
  * id
  * user_id
  cantidad
  tipo
  vence_en
  created_at
}

entity Transaction {
  * id
  * wallet_id
  tipo
  monto
  descripcion
  referencia
  created_at
}

entity Modalidad {
  * id
  * service_id
  tipo
  monedas_requeridas
  created_at
}

entity Milestone {
  * id
  * order_id
  numero
  descripcion
  monto
  estado
  aprobado_en
  created_at
}

User ||--|| Profile
User ||--o{ Service : "publica"
User ||--o{ Subscription
User ||--o{ Rating : "emite/recibe"
User ||--|| Wallet
User ||--o{ Coin
Service ||--o| Order
Service ||--o| Modalidad
Order ||--|| Payment
Order ||--o{ Dispute
Order ||--o{ Milestone
User ||--o{ LegalAcceptance
Wallet ||--o{ Transaction

@enduml
