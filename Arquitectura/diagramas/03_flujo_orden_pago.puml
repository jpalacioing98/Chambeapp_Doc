@startuml
title ChambeApp - Flujo Solicitud a Pago (Real)
actor Solicitante as S
actor PDS as P
participant "Solicitud" as SOL
participant "get_recommender()" as REC
participant "CascadeManager" as CAS
participant "Socket.IO" as SIO
participant "Contrato" as CON
participant "Chat" as CH
participant "Pago (MercadoPago/PSE)" as PAY

S -> SOL : publica (radio_km, categoria)
SOL -> REC : recomienda PDS (ML 2 etapas)
REC --> S : ranking con explicacion
SOL -> CAS : start_cascade()
CAS -> SIO : notificacion:nueva (2/5/15km)
SIO -> P : alerta en tiempo real
P -> SOL : envia oferta
SIO -> S : oferta:nueva
S -> CON : acepta oferta
CON -> CH : habilita chat
P -> CON : marca completado
S -> CON : confirma (dual)
CON -> PAY : genera orden pago
PAY -> S : cobra (MercadoPago/PSE)
PAY -> P : libera neto (comision)
@enduml
