@startuml
title Modulo 5 - Finanzas (Wallet, Pagos, Monedas)

skinparam monochrome true
skinparam shadowing false
hide stereotype
hide circle
hide methods
hide empty members

entity "users" as U {
  * id: int [PK]
  --
  email: varchar(255) [UK, NN]
  rol: enum [NN]
}

entity "contracts" as CON {
  * id: int [PK]
  --
  solicitud_id: int [FK -> solicitudes.id]
  proveedor_id: int [FK -> users.id]
  solicitante_id: int [FK -> users.id]
  estado: enum
  monto_total: int
  creado_en: datetime
}

entity "wallets" as W {
  * user_id: int [PK, FK -> users.id]
  --
  saldo: int
  saldo_bloqueado: int
  updated_at: datetime
}

entity "transactions" as T {
  * id: int [PK]
  --
  wallet_id: int [FK -> wallets.user_id]
  tipo: enum
  monto: int
  descripcion: text
  referencia: varchar(100)
  created_at: datetime
}

entity "payments" as PAY {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id, UK]
  monto: int
  comision_pds: int
  comision_solicitante: int
  estado: enum
  pasarela: varchar(50)
  referencia_pasarela: varchar(255)
  motivo_reembolso: varchar(500)
  creado_en: datetime
  actualizado_en: datetime
}

entity "coins" as CO {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  tipo: enum [COMPRADA/PROMOCIONAL/GANADA]
  cantidad: int
  vence_en: datetime
  created_at: datetime
}

entity "coin_packages" as CP {
  * id: int [PK]
  --
  nombre: varchar
  monedas: int
  precio_cop: int
  modalidad: enum [A/B]
  activo: bool
}

entity "precios_sugeridos" as PS {
  * id: int [PK]
  --
  categoria: varchar
  precio_min: int
  precio_max: int
  precio_promedio: int
  muestra_n: int
  actualizado_en: datetime
}

U ||--|| W : "tiene billetera (1:1)"
W ||--|{ T : "registra movimientos"
U ||--|{ CO : "posee monedas"

CON ||--|| PAY : "tiene un pago (1:1)"

@enduml
