@startuml
title Modulo 7 - Comunicacion (Chat, Notificaciones, Presencia)

skinparam monochrome true
skinparam shadowing false
hide stereotype
hide circle
hide methods
hide empty members

entity "users" as U {
  * id: int [PK]
  --
  email: varchar(255) [UK, NN]
  rol: enum [NN]
}

entity "conversations" as CV {
  * id: int [PK]
  --
  user_a_id: int [FK -> users.id]
  user_b_id: int [FK -> users.id]
  creado_en: datetime
}

entity "messages" as MSG {
  * id: int [PK]
  --
  conversation_id: int [FK -> conversations.id]
  sender_id: int [FK -> users.id]
  contenido: text
  leido: bool
  creado_en: datetime
}

entity "notifications" as NOTIF {
  * id: int [PK]
  --
  user_id: int [FK -> users.id]
  tipo: varchar
  titulo: varchar(200)
  mensaje: text
  datos: json
  leida: bool
  creado_en: datetime
}

entity "notification_preferences" as NP {
  * user_id: int [PK, FK -> users.id]
  --
  push_habilitado: bool
  in_app_habilitado: bool
  email_habilitado: bool
  categorias_json: json
}

entity "presence" as PR {
  * user_id: int [PK, FK -> users.id]
  --
  online: bool
  last_seen: datetime
  socket_id: varchar
  heartbeat_at: datetime
}

U ||--|{ CV : "participante A"
U ||--|{ CV : "participante B"
CV ||--|{ MSG : "contiene mensajes"
U ||--|{ MSG : "envia mensajes"
U ||--|{ NOTIF : "recibe notificaciones"
U ||--|| NP : "configura notificaciones (1:1)"
U ||--|| PR : "presencia en tiempo real (1:1)"

@enduml
