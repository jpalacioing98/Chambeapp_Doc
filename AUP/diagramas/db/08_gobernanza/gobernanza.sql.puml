@startuml
title Modulo 8 - Gobernanza y Auditoria (Esquema SQL)

skinparam monochrome true
skinparam shadowing false
hide stereotype
hide circle
hide methods
hide empty members

entity "users" as U {
  * id: int [PK]
  --
  email: varchar(255) [UK, NN]
  rol: enum [NN]
  region_id: int [FK -> regions.id]
}

entity "regions" as REG {
  * id: int [PK]
  --
  clave: varchar(40) [UK]
  nombre: varchar(120) [NN]
}

entity "contracts" as CON {
  * id: int [PK]
  --
  solicitud_id: int [FK -> solicitudes.id ON DELETE CASCADE]
  proveedor_id: int [FK -> users.id ON DELETE CASCADE]
  solicitante_id: int [FK -> users.id ON DELETE CASCADE]
  estado: enum DEFAULT 'pendiente'
  monto_total: int
  creado_en: datetime DEFAULT NOW()
}

entity "audit_logs" as AL {
  * id: int [PK]
  --
  actor_id: int [FK -> users.id ON DELETE CASCADE]
  accion: varchar [NN]
  entidad_tipo: varchar [NN]
  entidad_id: int [NN]
  snapshot_diff_json: json
  ip_address: varchar
  user_agent: varchar
  timestamp_utc: datetime DEFAULT NOW()
}

entity "disputes" as D {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id ON DELETE CASCADE]
  iniciado_por: int [FK -> users.id ON DELETE CASCADE]
  tipo: enum [pago/calificacion/alcance/incumplimiento] [NN]
  estado: enum DEFAULT 'abierta'
  resolucion: text
  resuelto_por: int [FK -> users.id]
  resuelto_en: datetime
  created_at: datetime DEFAULT NOW()
}

entity "tickets" as TK {
  * id: int [PK]
  --
  user_id: int [FK -> users.id ON DELETE CASCADE]
  tipo: enum [soporte/reclamo/sugerencia] [NN]
  prioridad: enum
  estado: enum DEFAULT 'abierto'
  asignado_a: int [FK -> users.id]
  respuesta: text
  creado_en: datetime DEFAULT NOW()
  cerrado_en: datetime
}

entity "moderacion_contenido" as MC {
  * id: int [PK]
  --
  entidad_tipo: varchar [NN]
  entidad_id: int [NN]
  reportado_por: int [FK -> users.id ON DELETE CASCADE]
  motivo: text [NN]
  estado: enum DEFAULT 'pendiente'
  accion_tomada: varchar
  moderador_id: int [FK -> users.id]
  created_at: datetime DEFAULT NOW()
}

entity "region_scoping" as RS2 {
  * admin_id: int [FK -> users.id ON DELETE CASCADE]
  * region_id: int [FK -> regions.id ON DELETE CASCADE]
  --
  permiso: enum [LECTURA/ESCRITURA/ADMIN] [NN]
}

index "ix_audit_logs_actor_timestamp" on AL(actor_id, timestamp_utc)
index "ix_disputes_contract_creado" on D(contract_id, created_at)
index "ix_disputes_status_creado" on D(estado, created_at)
index "ix_tickets_user_creado" on TK(user_id, creado_en)

U ||--|{ AL : "actor de auditoria"
CON ||--|{ D : "genera disputas"
U ||--|{ D : "inicia disputa"
U }|--o{ D : "resuelve disputa (opcional)"
U ||--|{ TK : "abre tickets"
U }|--o{ TK : "asignado a tickets (opcional)"
U ||--|{ MC : "reportado por"
U ||--|{ MC : "moderado por"
U ||--|{ RS2 : "admin con alcance regional"
REG ||--|{ RS2 : "alcance regional de"

note bottom of AL
  Indices: audit_logs(actor_id, timestamp_utc)
           disputes(contract_id, created_at), (estado, created_at)
           tickets(user_id, creado_en)
end note

@enduml
