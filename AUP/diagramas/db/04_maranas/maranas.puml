@startuml
title Modulo 4 - Maranas (Subcontratacion)

skinparam monochrome true
skinparam shadowing false
hide stereotype
hide circle
hide methods
hide empty members

entity "users" as U {
  * id: int [PK]
  --
  email: varchar(255) [UK, NN]
  rol: enum [NN]
}

entity "contracts" as CON {
  * id: int [PK]
  --
  solicitud_id: int [FK -> solicitudes.id]
  proveedor_id: int [FK -> users.id]
  solicitante_id: int [FK -> users.id]
  estado: enum
  monto_total: int
  creado_en: datetime
}

entity "maranas" as MA {
  * id: int [PK]
  --
  contract_id: int [FK -> contracts.id]
  pds_id: int [FK -> users.id]
  descripcion: text
  presupuesto: numeric
  estado: varchar
  created_at: datetime
}

entity "ofertas_marana" as OM {
  * id: int [PK]
  --
  marana_id: int [FK -> maranas.id]
  pds_id: int [FK -> users.id]
  precio: numeric
  mensaje: text
  estado: varchar
  created_at: datetime
}

CON ||--|{ MA : "deriva a marañas"
U ||--|{ MA : "PDS gestiona marana"

MA ||--|{ OM : "recibe ofertas de marana"
U ||--|{ OM : "PDS ofertar en marana"

@enduml
